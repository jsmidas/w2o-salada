# ============================================================
# W2O SALADA — 환경변수 예시
# 이 파일을 복사해 .env 를 만들고 값을 채운다.  (코드가 실제로 참조하는 키 기준)
# [필수] 누락 시 빌드/런타임 크래시,  [선택] 없으면 해당 기능만 비활성.
# ============================================================

# ── 데이터베이스 (필수) ──
# DATABASE_URL: 앱 런타임용 (Supabase pooler, pgbouncer).
# DIRECT_URL  : prisma migrate/seed 등 직결용 (5432 다이렉트).
DATABASE_URL="postgresql://user:password@localhost:5432/w2o_salada"
DIRECT_URL="postgresql://user:password@localhost:5432/w2o_salada"

# ── Supabase (필수) ──
# 브라우저 공개용 (NEXT_PUBLIC_*) — anon 키. JS 번들에 노출되므로 RLS로 보호.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# 서버 전용 — service role 키. RLS 우회. NEXT_PUBLIC_ 접두사 절대 금지.
# Supabase 대시보드 → Project Settings → API → service_role.
# Storage 업로드(/api/upload) 등 관리자 동작에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=""

# ── NextAuth (필수) ──
# 코드는 NEXTAUTH_SECRET 을 읽는다(auth.ts). 미설정 시 공개된 dev 기본값으로
# 폴백 → 세션 위조 위험이므로 프로덕션에는 반드시 설정. AUTH_SECRET 은 v5 표준 별칭.
# 생성: `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# ── 소셜 로그인 (선택: 해당 provider만 비활성) ──
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
# 카카오 로컬 API(주소→좌표, 배송 반경 판정). 비우면 KAKAO_CLIENT_ID(같은 REST API 키)를 쓴다.
# Kakao Developers → 앱 → 제품 설정 → "카카오맵" 서비스를 켜야 동작한다.
KAKAO_REST_API_KEY=""
# 대체 지오코더 — 국토부 VWorld (https://www.vworld.kr 오픈API 인증키, 무료·결제수단 불필요). 카카오가 안 되면 이 키로 좌표를 찾는다.
VWORLD_API_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── 토스페이먼츠 (필수) ──
# 클라이언트 키는 결제창 SDK용이라 NEXT_PUBLIC_ 접두사 필요(브라우저 노출 정상).
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# ── 빌링키 암호화 (필수) ──
# AES-256-GCM용 32바이트 = 64자 hex 키. 미설정 시 정기결제/구독 전체 throw.
# 분실 시 기존 암호화 빌링키 복호화 불가 → 고객 재등록 필요.
# 모든 환경(Production/Preview/Development)에서 같은 값을 써야 교차 복호화가 깨지지 않는다.
# 생성: `openssl rand -hex 32`
BILLING_ENCRYPTION_KEY=""

# ── Cron 보호 (필수) ──
# /api/cron/* 인증용. 미설정 시 인증 검사가 스킵돼 cron 엔드포인트가 무인증 공개됨.
# Vercel은 이 값이 있으면 Cron 호출 시 자동으로 Authorization: Bearer <CRON_SECRET> 첨부.
# 생성: `openssl rand -hex 32`
CRON_SECRET=""

# ── 알림톡/SMS — 솔라피(SOLAPI) ──
# API_KEY/SECRET 둘 다 있어야 실제 발송(없으면 조용히 skip — notification.ts isLiveMode).
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""          # 카카오 채널 pfId (알림톡 발신)
SOLAPI_SENDER_PHONE=""  # 발신 등록번호 (SMS 폴백용)
# 카카오 알림톡 템플릿 ID — 없으면 해당 건은 알림톡 대신 일반 SMS로 폴백(비용↑·브랜딩X).
SOLAPI_TEMPLATE_ORDER_PAID=""
SOLAPI_TEMPLATE_DELIVERY_START=""
SOLAPI_TEMPLATE_DELIVERY_DONE=""
SOLAPI_TEMPLATE_SUB_PAID=""
SOLAPI_TEMPLATE_PAYMENT_FAIL=""

# ── Sentry 에러 모니터링 (선택: 비워두면 비활성화) ──
NEXT_PUBLIC_SENTRY_DSN=""
# 소스맵 업로드용 (선택, 없으면 스택트레이스가 난독화됨)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Redis (현재 미사용: 향후 BullMQ 워커 도입 시) ──
# 정기결제·알림은 현재 Vercel Cron으로 처리. 워커 분리 시 사용.
# REDIS_URL="redis://localhost:6379"
