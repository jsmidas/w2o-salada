generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── 회원 ──
model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  email         String    @unique
  password      String?
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  permissions   String?   // JSON: ["dashboard","orders","products","subscriptions","customers","system"] — null = 슈퍼관리자(전체권한)
  provider      String?   // kakao, naver, email
  providerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
  notifications Notification[]
  reviews       Review[]
  inquiries     Inquiry[]
  driverRoutes  DeliveryRoute[] @relation("RouteDriver") // 기사 계정(DRIVER)이 맡은 코스

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
  DRIVER
}

// ── 배송지 ──
model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  name         String  // 수령인
  phone        String
  zipCode      String
  address1     String  // 기본 주소
  address2     String? // 상세 주소
  isDefault    Boolean @default(false)
  deliveryMemo String?

  // ── 출입·수령 정보 (배송지마다 다르다: 공동현관 비밀번호, 갖다둘 곳, 층수) ──
  label            String?      // "집", "부모님 댁", "사무실" — 한 회원이 여러 곳에 보낼 때 구분
  entranceMethod   String?      // "공동현관 비밀번호" / "경비실 호출" / "자유 출입" 등 자유 서술
  entrancePassword String?      // 공동현관 비밀번호 — 관리자 화면 기본 가림, 기사 출력본에는 배송일 당일만
  floor            String?      // "3층", "지하1층" — 엘리베이터 없는 건물 판단용
  dropLocation     DropLocation @default(DOOR) // 갖다둘 곳
  dropNote         String?      // "택배함 3번", "경비실 야간 창구" 등 보조 설명

  // ── 위치 정보 (배송 코스 1단계) ──
  // 다음 우편번호 API가 주는 값을 가공 없이 저장한다. buildingName은 단지 묶음의 키.
  sido         String?  // 대구
  sigungu      String?  // 달서구
  bname        String?  // 이곡동 (법정동)
  buildingName String?  // 성서주공1단지 — 표기 그대로 보존
  isApartment  Boolean  @default(false) // 다음 API apartment === "Y"
  roadAddress  String?  // 도로명 주소 (지오코딩 질의용)
  jibunAddress String?  // 지번 주소
  // 좌표·반경 판정 (카카오 로컬 API로 수집, 실패 시 UNKNOWN)
  lat          Float?
  lng          Float?
  distanceKm   Float?   // 가장 가까운 물류센터까지 거리 (캐시)
  areaStatus   DeliveryAreaStatus @default(UNKNOWN)
  geocodedAt   DateTime?
  // 사전 등록 단지와 매칭된 결과 (buildingName ↔ Apartment.name/aliases)
  apartmentId  String?
  apartment    Apartment? @relation(fields: [apartmentId], references: [id])
  // 고정 코스 원칙 — 같은 배송지는 지난번 코스를 기본값으로 채운다 (관리자는 새 주소만 배정)
  lastRouteId  String?
  lastRoute    DeliveryRoute? @relation("AddressLastRoute", fields: [lastRouteId], references: [id])
  createdAt    DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]

  @@index([sigungu, bname])
  @@index([buildingName])
  @@index([areaStatus])
  @@map("addresses")
}

// 갖다둘 곳
enum DropLocation {
  DOOR            // 문 앞
  SECURITY_OFFICE // 경비실
  PARCEL_BOX      // 택배함
  OTHER           // 기타 (dropNote 참고)
}

// 배송 가능 판정 — 센터 반경 기준. 좌표를 못 얻으면 UNKNOWN(사람이 확인)
enum DeliveryAreaStatus {
  UNKNOWN      // 좌표 없음 → 관리자 확인 필요
  IN_RANGE     // 반경 이내 (또는 허용 동 화이트리스트)
  OUT_OF_RANGE // 반경 초과 → 접수 후 주간에 전화 안내
}

// ── 아파트 단지 사전 등록 ──
// 공공데이터(공동주택 단지 정보) 또는 수동 등록. 단지명 표기 흔들림 보정 + 침투율 집계 + 영업 우선순위.
model Apartment {
  id          String   @id @default(cuid())
  name        String   // 단지명 (기준 표기)
  aliases     String[] @default([]) // 표기 흔들림 보정용 ("성서주공 1단지" 등)
  address     String?  // 대표 주소
  sigungu     String?
  bname       String?
  households  Int?     // 세대수
  dongCount   Int?     // 동수
  lat         Float?
  lng         Float?
  distanceKm  Float?   // 센터에서의 거리 (캐시)
  isServiced  Boolean  @default(false) // 배송 개시 여부
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses Address[]

  @@index([sigungu, bname])
  @@index([name])
  @@map("apartments")
}

// ── 카테고리 ──
model Category {
  id       String    @id @default(cuid())
  name     String    // 샐러드, 간편식, 반찬 등
  slug     String    @unique
  sortOrder Int      @default(0)
  icon     String?   // material-symbols 아이콘 이름 (예: eco, lunch_dining)
  color    String?   // hex 색상 (예: #1D9E75)
  isActive Boolean   @default(true) // 공개 여부
  isOption Boolean   @default(false) // true면 본품 아님 (최소 주문액 계산 제외) — 음료/유산균 등
  products Product[]

  @@map("categories")
}

// ── 상품 (메뉴) ──
model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  originalPrice Int?     // 정가 (원)
  singlePrice Int?       // 단건 주문가 (원) — 없으면 price 사용. 정가 > 단건가 > 구독가 3-티어 모델의 중간 값
  price       Int      // 구독 판매가 (원, 부가세 포함) — 구독 시 적용
  nextPrice              Int?      // 예약 인상가 — nextPriceEffectiveFrom 도래 시 price로 자동 승격
  nextPriceEffectiveFrom DateTime? // 예약 인상 적용일 (KST 자정)
  kcal        Int?
  imageUrl    String?
  tags        String?  // "BEST", "NEW", "SALE" 등
  isActive    Boolean  @default(true)
  stock       Int      @default(999)
  dailyLimit  Int?     // 일일 제한 수량 (null=무제한)
  availableDays String? // 배송 가능 요일 "월,수,금" 또는 null=매일
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems              OrderItem[]
  subscriptionItems       SubscriptionItem[]
  menuSchedules           MenuSchedule[]
  menuAssignments         MenuAssignment[]
  subscriptionSelections  SubscriptionSelection[]
  reviews                 Review[]

  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

// ── 주문 ──
model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique // W2O-20260401-0001
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?    @relation(fields: [addressId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  type            OrderType   @default(SINGLE)
  status          OrderStatus @default(PENDING)
  totalAmount     Int         // 총 결제 금액
  deliveryFee     Int         @default(0)
  discountAmount  Int         @default(0)
  paymentKey      String?     // 토스 paymentKey
  paidAt          DateTime?
  deliveryDate    DateTime?   // 배송 예정일
  deliveredAt     DateTime?
  // 배송지 확인 보류 — 반경 밖·좌표 불명 주소는 결제를 막지 않고 접수한 뒤 주간에 전화로 판단한다
  deliveryHold           Boolean   @default(false)
  deliveryHoldReason     String?   // "반경 초과 7.3km" / "좌표 확인 불가"
  deliveryHoldResolvedAt DateTime?
  deliveryHoldNote       String?   // 담당자 처리 메모 (통화 결과)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items     OrderItem[]
  payments  Payment[]
  delivery  Delivery?

  @@index([deliveryHold])
  @@unique([subscriptionId, deliveryDate, type]) // 구독 배송 건은 배송일당 1건 (멱등 생성)
  @@map("orders")
}

enum OrderType {
  SINGLE
  SUBSCRIPTION          // 구독 월 결제 주문 (돈의 기록 — 배송 대상 아님)
  SUBSCRIPTION_DELIVERY // 구독 배송일별 배송 건 (금액 0 — 배송·피킹·기사 출력 대상)
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

// ── 주문 상품 ──
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int
  totalPrice Int

  @@map("order_items")
}

// ── 결제 ──
model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  paymentKey   String?       // 토스 paymentKey
  method       String?       // CARD, KAKAOPAY, NAVERPAY
  amount       Int
  status       PaymentStatus @default(READY)
  billingKey   String?       // 정기결제용 (암호화)
  receiptUrl   String?
  cancelReason String?
  cancelledAt  DateTime?
  rawResponse  String?       // 토스 원본 응답 (JSON 문자열)
  createdAt    DateTime      @default(now())

  @@map("payments")
}

enum PaymentStatus {
  READY
  DONE
  CANCELLED
  REFUNDED
  FAILED
}

// ── 정기구독 ──
model Subscription {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  addressId         String?            // 구독 배송지 (갱신 주문이 이 주소를 복사한다)
  address           Address?           @relation(fields: [addressId], references: [id])
  planType          PlanType?          // deprecated, optional로 유지
  frequency         Frequency?         // deprecated, optional로 유지
  selectionMode     SelectionMode      @default(MANUAL)
  itemsPerDelivery  Int                @default(2)  // 배송당 수량 (슬롯 합과 동기화)
  slots             Json?              // 카테고리별 슬롯 { "salad": 2, "simple": 1, ... } — key=Category.slug
  status            SubscriptionStatus @default(PENDING)
  billingKey        String?            // 토스 빌링키 (암호화)
  nextBillingDate   DateTime?
  nextDeliveryDate  DateTime?
  renewalNotifiedAt DateTime?          // 갱신 사전 알림 발송일
  price             Int
  startedAt         DateTime?
  pausedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items   SubscriptionItem[]
  periods SubscriptionPeriod[]
  orders  Order[]

  @@map("subscriptions")
}

enum SelectionMode {
  MANUAL  // 고객 직접 선택
  AUTO    // 잘 챙겨서 보내줘 (위임형)
}

enum PlanType {
  LIGHT
  REGULAR
  PREMIUM
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

// ── 구독 메뉴 구성 ──
model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)
  dayOfWeek      Int?         // 0=일, 1=월 ~ 6=토

  @@map("subscription_items")
}

// ── 배송 ──
model Delivery {
  id            String         @id @default(cuid())
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id])
  driverId      String?        // 레거시: 코스명 표시용 라벨 (routeId 가 정식 참조, 코스명 변경 시 동기화)
  routeId       String?
  route         DeliveryRoute? @relation(fields: [routeId], references: [id])
  status        DeliveryStatus @default(PENDING)
  scheduledDate DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  photoUrl      String?        // 배송 확인 사진
  memo          String?
  sortOrder     Int            @default(0) // 배송 코스 순서

  @@index([routeId, scheduledDate])
  @@map("deliveries")
}

// ── 배송 코스 마스터 — 코스 = 차량 1대의 하루. 기사 계정과 연결 ──
model DeliveryRoute {
  id           String         @id @default(cuid())
  name         String         @unique // "A코스" — 운영 시 지역명으로 바꿔도 배정은 id 로 유지된다
  driverUserId String?
  driver       User?          @relation("RouteDriver", fields: [driverUserId], references: [id])
  vehicleNo    String?
  ownership    RouteOwnership @default(OWN) // 자차 / 용차 — 자동 배정 시 자차부터 채운다
  maxStops     Int            @default(100) // 집 수 기준 목표
  departOrder  Int            @default(0)   // 출고·상차 순번
  color        String?        // 화면 구분색
  memo         String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  deliveries    Delivery[]
  lastAddresses Address[]     @relation("AddressLastRoute")

  @@map("delivery_routes")
}

enum RouteOwnership {
  OWN        // 자차 (주간 차량 야간 재사용 — 고정비 없음)
  OUTSOURCED // 용차 (최소비용 보장)
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

// ── 알림 ──
model Notification {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  type         NotificationType
  templateCode String?
  content      String
  sentAt       DateTime?
  status       NotificationStatus @default(PENDING)
  createdAt    DateTime           @default(now())

  @@map("notifications")
}

enum NotificationType {
  ALIMTALK
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ── 상품 상세페이지 ──
model ProductPage {
  id                 String   @id @default(cuid())
  productId          String   @unique
  heroImages         String?  // JSON: ["url1","url2"]
  subtitle           String?
  featureTitle       String?
  featureDescription String?
  featureImages      String?  // JSON: ["url1"]
  keyPoints          String?  // JSON: [{icon,title,description}]
  specs              String?  // JSON: [{label,value}]
  detailDescription  String?
  detailImages       String?  // JSON: ["url1"]
  nutrition          String?  // JSON: [{label,value}]
  galleryImages      String?  // JSON: ["url1"]
  sectionOrder       String?  // JSON: ["hero","feature","keypoints",...]
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("product_pages")
}

// ── 배송일 캘린더 (관리자 지정) ──
model DeliveryCalendar {
  id        String   @id @default(cuid())
  date      DateTime @unique
  isActive  Boolean  @default(true)
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuAssignments MenuAssignment[]

  @@map("delivery_calendar")
}

// ── 날짜별 제공 메뉴 (관리자 배정) ──
model MenuAssignment {
  id                 String           @id @default(cuid())
  deliveryCalendarId String
  deliveryCalendar   DeliveryCalendar @relation(fields: [deliveryCalendarId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([deliveryCalendarId, productId])
  @@map("menu_assignments")
}

// ── 월별 구독 사이클 ──
model SubscriptionPeriod {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  year           Int
  month          Int
  status         PeriodStatus @default(PENDING)
  totalAmount    Int          @default(0)
  orderId        String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  selections SubscriptionSelection[]

  @@unique([subscriptionId, year, month])
  @@map("subscription_periods")
}

enum PeriodStatus {
  PENDING
  PAID
  DELIVERING
  COMPLETED
  CANCELLED
}

// ── 고객 날짜별 메뉴 선택 ──
model SubscriptionSelection {
  id                   String             @id @default(cuid())
  subscriptionPeriodId String
  subscriptionPeriod   SubscriptionPeriod @relation(fields: [subscriptionPeriodId], references: [id], onDelete: Cascade)
  deliveryDate         DateTime
  productId            String
  product              Product            @relation(fields: [productId], references: [id])
  quantity             Int                @default(1)
  unitPrice            Int?               // 결제 시점 단가 잠금 (계약가) — null이면 product.price fallback

  @@map("subscription_selections")
}

// ── 식단 배정 (레거시, deprecated) ──
model MenuSchedule {
  id        String @id @default(cuid())
  year      Int    // 2026
  month     Int    // 1~12
  week      Int    // 1~4 (해당 월의 주차)
  day       String // "tue" | "thu"
  slot      Int    // 슬롯 순서 (0, 1, 2 ...)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, week, day, slot])
  @@map("menu_schedules")
}

// ── 리뷰 ──
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String?  // 주문 연결 (선택)
  rating    Int      // 1~5
  content   String
  images    String?  // JSON array of image URLs
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

// ── 1:1 문의 ──
model Inquiry {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  name      String        // 문의자 이름
  phone     String        // 연락처
  category  String        @default("general") // delivery, payment, product, general 등
  content   String        // 문의 내용
  images    String?       // JSON array of image URLs
  status    InquiryStatus @default(PENDING)
  reply     String?       // 관리자 답변
  repliedBy String?       // 답변한 관리자 ID
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("inquiries")
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

// ── 휴대폰 인증 (아이디·비밀번호 찾기) ──
// 한 행 = 인증코드 1회 발송. 코드는 해시로만 저장, 검증 성공 시 resetTokenHash 발급.
model PhoneVerification {
  id             String    @id @default(cuid())
  phone          String    // 숫자만 (01012345678)
  purpose        String    @default("FIND_ACCOUNT")
  codeHash       String    // sha256(code + salt)
  attempts       Int       @default(0)   // 코드 검증 시도 횟수 (5회 초과 시 폐기)
  expiresAt      DateTime  // 코드 만료 (발송 + 5분)
  verifiedAt     DateTime?
  resetTokenHash String?   // 검증 후 발급되는 비밀번호 재설정 토큰(해시)
  usedAt         DateTime? // 재설정 완료 시각
  createdAt      DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("phone_verifications")
}

// ── 쇼핑몰 설정 (key-value) ──
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
